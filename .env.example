# 扣子 API（变量名勿用 COZE_ 前缀，扣子环境变量不允许）
ZJ_API_BASE_URL=https://api.coze.cn

# 个人访问令牌 PAT（勿提交真实值；复制本文件为 .env 后填写）
ZJ_API_TOKEN=pat_替换为你的令牌

# 工作空间 Space ID
ZJ_SPACE_ID=7524578716388196387

# 「旅客陪练」Bot ID
ZJ_TUTOR_BOT_ID=7697511548315009039

# 「值机柜台考评员」Bot ID
ZJ_EVALUATOR_BOT_ID=7697505542373785654

# 实时语音（旅客陪练音色与 WebSocket）
ZJ_VOICE_ID=7426720361732980745
ZJ_WS_BASE_URL=wss://ws.coze.cn

# PostgreSQL（示例，勿把生产密码提交仓库）
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@HOST:5432/postgres?sslmode=require

# 会话与管理员
SESSION_SECRET=请换成随机字符串
ADMIN_EMAIL=admin@coze.dev
ADMIN_PHONE=13699225251
ADMIN_INIT_PASSWORD=Admin123456

# 本地开发（可选）
# APP_ENV=DEV
# PORT=5000
